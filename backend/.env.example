# MineGuard Backend Environment Configuration — Example File
# Copy this file to '.env' in backend directory for local development.

# Security Secrets (Generate a strong secret key for production, e.g. via `openssl rand -hex 32`)
SECRET_KEY=dev-secret-key-please-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration (SQLite default for local development, PostgreSQL for production)
DATABASE_URL=sqlite:///./mineguard.db
# PostgreSQL Example: DATABASE_URL=postgresql://mineguard_user:securepassword@localhost:5432/mineguard_db

# Demo Data Initialization (Set to true to seed demo mine sites, sensors, and safety accounts on startup)
SEED_DEMO_DATA=true

# CORS Allowed Origins (Comma-separated list of allowed frontend origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:49407,http://127.0.0.1:5173

# Optional SMTP Email Dispatch Configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DEFAULT_ALERT_EMAIL=dgms-jharkhand@gov.in

# Optional SMS Gateway Dispatch Configuration
SMS_API_KEY=
SMS_PROVIDER_URL=
DEFAULT_ALERT_SMS=+91-9801XXXXXX
